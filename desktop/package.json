{
  "name": "sanguo-weizhu-desktop",
  "version": "1.0.2",
  "description": "San Guo: Tianxia Weizhu - a Three-Kingdoms Texas hold'em saga (desktop shell)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.ggcode.san",
    "productName": "sanguo-weizhu",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "sanguo-weizhu-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "artifactName": "sanguo-weizhu-${version}-${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "sanguo-weizhu-${version}.${ext}"
    },
    "executableName": "sanguo-weizhu"
  },
  "homepage": "https://github.com/topcheer/sanguo-tianxia-weizhu",
  "author": {
    "name": "topcheer",
    "email": "topcheer@users.noreply.github.com"
  }
}