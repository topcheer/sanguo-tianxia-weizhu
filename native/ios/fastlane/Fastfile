# Fastfile for 三国：天下为注 (dev.ggcode.san)
# CI 优先从环境变量读 ASC API key(GitHub Actions secrets),
# 本地回退到 LumenStudy 路径(手动 lane 用)。
default_platform(:ios)

def api_key
  if ENV["SAN_API_KEY_P8"]
    key_filepath = "/tmp/AuthKey_#{ENV['SAN_API_KEY_ID']}.p8"
    File.write(key_filepath, ENV["SAN_API_KEY_P8"]) unless File.exist?(key_filepath)
    app_store_connect_api_key(
      key_id: ENV["SAN_API_KEY_ID"],
      issuer_id: ENV["SAN_API_ISSUER"],
      key_filepath: key_filepath,
      in_house: false
    )
  else
    app_store_connect_api_key(
      key_id: "8KNYUZ47F2",
      issuer_id: "69a6de7d-3567-47e3-e053-5b8c7c11a4d1",
      key_filepath: "/Volumes/new/ggai/LumenStudy/ios/fastlane/AuthKey_8KNYUZ47F2.p8",
      in_house: false
    )
  end
end

platform :ios do
  desc "Upload metadata + screenshots (no binary)"
  lane :upload_metadata do
    deliver(
      api_key: api_key,
      app_identifier: "dev.ggcode.san",
      skip_binary_upload: true,
      skip_screenshots: false,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false
    )
  end

  desc "Upload IPA to TestFlight"
  lane :upload_testflight do |options|
    pilot(
      api_key: api_key,
      ipa: options[:ipa],
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Upload macOS pkg to App Store Connect (TestFlight)"
  lane :upload_mac_pkg do |options|
    deliver(
      api_key: api_key,
      app_identifier: "dev.ggcode.san",
      pkg: options[:pkg],
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end
end
