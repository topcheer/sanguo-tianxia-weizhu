 "gen.luxun.bark.badbeat": "这一局,算错了。",
 "gen.menghuo.name": "孟获",
 "gen.menghuo.bio": "七擒七纵的南王。",
 "gen.menghuo.tell.strong": "拍案而起,碗盏乱跳",
 "gen.menghuo.tell.weak": "挠头,嘿嘿干笑",
 "gen.menghuo.bark.open": "南王孟获!",
 "gen.menghuo.bark.taunt": "不服!",
 "gen.menghuo.bark.tilt": "再打过!",
 "gen.menghuo.bark.smug": "南中无敌!",
 "gen.menghuo.bark.badbeat": "……服了。",
 "gen.caozhen.name": "曹真",
 "gen.caozhen.bio": "曹魏宗室名将。",
 "gen.caozhen.tell.strong": "按剑正坐,不动如山",
 "gen.caozhen.tell.weak": "挪动了一下坐姿",
 "gen.caozhen.bark.open": "曹真,督诸军。",
 "gen.caozhen.bark.taunt": "哼。",
 "gen.caozhen.bark.tilt": "出战!",
 "gen.caozhen.bark.smug": "魏军威武。",
 "gen.caozhen.bark.badbeat": "孔明……果然。",
 "gen.zhanghe.name": "张郃",
 "gen.zhanghe.bio": "巧变善战的名将。",
 "gen.zhanghe.tell.strong": "坐姿前倾,如狐伺兔",
 "gen.zhanghe.tell.weak": "后退半步,重新打量你",
 "gen.zhanghe.bark.open": "张郃,请。",
 "gen.zhanghe.bark.taunt": "哦?",
 "gen.zhanghe.bark.tilt": "击破他们!",
 "gen.zhanghe.bark.smug": "兵无常势。",
 "gen.zhanghe.bark.badbeat": "街亭之后,再无退路……",
 "gen.simayi.name": "司马懿",
 "gen.simayi.bio": "冢虎。耗得起的,都赢了。",
 "gen.simayi.tell.strong": "闭目养神,呼吸绵长",
 "gen.simayi.tell.weak": "指节叩桌,三短一长",
 "gen.simayi.bark.open": "(闭目)……请发牌。",
 "gen.simayi.bark.taunt": "(微笑,不为所动)",
 "gen.simayi.bark.tilt": "……",
 "gen.simayi.bark.smug": "(嘴角微动)",
 "gen.simayi.bark.badbeat": "……无妨。",
 "gen.dengai.name": "邓艾",
 "gen.dengai.bio": "偷渡阴平的口吃将军。",
 "gen.dengai.tell.strong": "口吃,目光却如炬",
 "gen.dengai.tell.weak": "搓着衣角,结巴得更厉害",
 "gen.dengai.bark.open": "邓、邓艾,请战。",
 "gen.dengai.bark.taunt": "你、你……",
 "gen.dengai.bark.tilt": "放、放马过来!",
 "gen.dengai.bark.smug": "险、险中求胜。",
 "gen.dengai.bark.badbeat": "阴平……太险了。",
 "gen.simayan.name": "司马炎",
 "gen.simayan.bio": "三分归一的晋武帝。",
 "gen.simayan.tell.strong": "冕旒不动,居高临下",
 "gen.simayan.tell.weak": "频频看向殿外",
 "gen.simayan.bark.open": "朕,司马炎。",
 "gen.simayan.bark.taunt": "大胆!",
 "gen.simayan.bark.tilt": "拖下去!",
 "gen.simayan.bark.smug": "天下归晋。",
 "gen.simayan.bark.badbeat": "朕的江山……",
 "gen.machao.name": "马超",
 "gen.machao.bio": "锦袍银枪,西凉之怒。",
 "gen.machao.tell.strong": "枪杆横在膝上,杀气不藏",
 "gen.machao.tell.weak": "回头看了一眼西凉来的兵",
 "gen.machao.bark.open": "西凉马超,谁敢应战!",
 "gen.machao.bark.taunt": "杀父之仇,不共戴天!",
 "gen.machao.bark.tilt": "全军突击,一个不留!",
 "gen.machao.bark.smug": "神威天将军。",
 "gen.machao.bark.badbeat": "父……叔……",
 "gen.yanliang.name": "颜良",
 "gen.yanliang.bio": "河北第一刀,势不可当。",
 "gen.yanliang.tell.strong": "大刀平举,连营肃静",
 "gen.yanliang.tell.weak": "阵前来回踱步,等得不耐",
 "gen.yanliang.bark.open": "河北颜良,列阵!",
 "gen.yanliang.bark.taunt": "又来一个送死的!",
 "gen.yanliang.bark.tilt": "给我踏平!",
 "gen.yanliang.bark.smug": "无人可挡。",
 "gen.yanliang.bark.badbeat": "这人……不对劲!",
 "gen.wenchou.name": "文丑",
 "gen.wenchou.bio": "河北双壁,与颜良并驱。",
 "gen.wenchou.tell.strong": "铁枪顿地,目中无人",
 "gen.wenchou.tell.weak": "听见「颜良」二字便咬牙",
 "gen.wenchou.bark.open": "文丑在此,替颜良讨回来!",
 "gen.wenchou.bark.taunt": "退!再退试试!",
 "gen.wenchou.bark.tilt": "把欠的都还来!",
 "gen.wenchou.bark.smug": "不过如此。",
 "gen.wenchou.bark.badbeat": "又是这个红脸……",
 "gen.xuchu.name": "许褚",
 "gen.xuchu.bio": "虎痴。力大,心更直。",
 "gen.xuchu.tell.strong": "赤膊拍案,声震屋瓦",
 "gen.xuchu.tell.weak": "挠头,想不明白就再看一眼",
 "gen.xuchu.bark.open": "谯县许褚,请!",
 "gen.xuchu.bark.taunt": "再说一遍?",
 "gen.xuchu.bark.tilt": "虎侯发怒了!",
 "gen.xuchu.bark.smug": "主公看好了。",
 "gen.xuchu.bark.badbeat": "俺……没看清!",
 "gen.zhangliao.name": "张辽",
 "gen.zhangliao.bio": "八百破十万的那个人。",
 "gen.zhangliao.tell.strong": "按辔不动,先数你的营",
 "gen.zhangliao.tell.weak": "笑声里透出一丝疲惫",
 "gen.zhangliao.bark.open": "雁门张文远,领教。",
 "gen.zhangliao.bark.taunt": "文远只管向前。",
 "gen.zhangliao.bark.tilt": "随我冲阵!",
 "gen.zhangliao.bark.smug": "还能再守十年。",
 "gen.zhangliao.bark.badbeat": "合肥……不可失。",
 "gen.pangde.name": "庞德",
 "gen.pangde.bio": "抬榇决死战,不回头。",
 "gen.pangde.tell.strong": "抬棺的手,稳过握刀的手",
 "gen.pangde.tell.weak": "摩挲腰间空了的酒葫芦",
 "gen.pangde.bark.open": "南安庞德,前来送死。",
 "gen.pangde.bark.taunt": "榇已在侧,何惧之有!",
 "gen.pangde.bark.tilt": "今日便分生死!",
 "gen.pangde.bark.smug": "幸不辱命。",
 "gen.pangde.bark.badbeat": "榇……终究用上了。",
 "gen.taishici.name": "太史慈",
 "gen.taishici.bio": "猿臂善射,信义为先。",
 "gen.taishici.tell.strong": "短戟在袖,背弓不卸",
 "gen.taishici.tell.weak": "望了一眼旧主的营",
 "gen.taishici.bark.open": "东莱太史慈,请战。",
 "gen.taishici.bark.taunt": "大丈夫岂惧你!",
 "gen.taishici.bark.tilt": "看箭!",
 "gen.taishici.bark.smug": "神射未老。",
 "gen.taishici.bark.badbeat": "大丈夫,当带三尺剑……",
 "gen.ganning.name": "甘宁",
 "gen.ganning.bio": "锦帆贼出身的斗将。",
 "gen.ganning.tell.strong": "铃铛一响,刀已出鞘",
 "gen.ganning.tell.weak": "摩挲着颈上的铜铃",
 "gen.ganning.bark.open": "锦帆甘兴霸,见过没有?",
 "gen.ganning.bark.taunt": "百骑劫营,听过没有?",
 "gen.ganning.bark.tilt": "都给爷留下!",
 "gen.ganning.bark.smug": "铃响,人至。",
 "gen.ganning.bark.badbeat": "乌鸦……叫得真吵。",
 "gen.huangzu.name": "黄祖"
}