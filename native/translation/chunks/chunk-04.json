 "gen.huanggai.tell.weak": "揉了揉背上未愈的杖痕",
 "gen.huanggai.bark.open": "老将黄盖,愿打头阵。",
 "gen.huanggai.bark.taunt": "皮肉之苦,算得了什么!",
 "gen.huanggai.bark.tilt": "火船,起!",
 "gen.huanggai.bark.smug": "三世旧臣,言出必行。",
 "gen.huanggai.bark.badbeat": "这一仗,老骨头交了……",
 "gen.chengpu.name": "程普",
 "gen.chengpu.bio": "三朝元老,铁脊蛇矛。",
 "gen.chengpu.tell.strong": "蛇矛拄地,老而弥坚",
 "gen.chengpu.tell.weak": "叹一句「周郎小儿」又收住",
 "gen.chengpu.bark.open": "程普,字德谋。",
 "gen.chengpu.bark.taunt": "欺我年迈?",
 "gen.chengpu.bark.tilt": "老夫再战一场!",
 "gen.chengpu.bark.smug": "江东基业,有我一份。",
 "gen.chengpu.bark.badbeat": "后生……可畏啊。",
 "gen.handang.name": "韩当",
 "gen.handang.bio": "义从老兵,弓马不辍。",
 "gen.handang.tell.strong": "弓开满月,大呼陷阵",
 "gen.handang.tell.weak": "默默替士卒紧甲",
 "gen.handang.bark.open": "韩当,字义公。",
 "gen.handang.bark.taunt": "辽东男儿,岂惧你!",
 "gen.handang.bark.tilt": "随老夫冲!",
 "gen.handang.bark.smug": "弓马,未曾生疏。",
 "gen.handang.bark.badbeat": "义从……所剩无几了。",
 "gen.zhoutai.name": "周泰",
 "gen.zhoutai.bio": "十二处伤,换主公一命。",
 "gen.zhoutai.tell.strong": "解甲示疤,浑身是胆",
 "gen.zhoutai.tell.weak": "把主公往身后拢了拢",
 "gen.zhoutai.bark.open": "周泰,字幼平。",
 "gen.zhoutai.bark.taunt": "这条疤,便是答话!",
 "gen.zhoutai.bark.tilt": "伤我主者,先过我!",
 "gen.zhoutai.bark.smug": "疤,又添一处而已。",
 "gen.zhoutai.bark.badbeat": "主公……先走!",
 "gen.lingtong.name": "凌统",
 "gen.lingtong.bio": "父仇在心,公义在前。",
 "gen.lingtong.tell.strong": "咬着牙出枪,快而狠",
 "gen.lingtong.tell.weak": "听见甘宁的铃就攥紧拳",
 "gen.lingtong.bark.open": "凌统,字公绩。",
 "gen.lingtong.bark.taunt": "杀父之仇,且记下!",
 "gen.lingtong.bark.tilt": "与我父亲的旧部,冲!",
 "gen.lingtong.bark.smug": "国士,不逞私斗。",
 "gen.lingtong.bark.badbeat": "断后……是死路。",
 "gen.dingfeng.name": "丁奉",
 "gen.dingfeng.bio": "雪中奋短兵的老将。",
 "gen.dingfeng.tell.strong": "脱甲提刀,雪里列队",
 "gen.dingfeng.tell.weak": "眯眼算风向与敌粮",
 "gen.dingfeng.bark.open": "丁奉,字承渊。",
 "gen.dingfeng.bark.taunt": "短兵,才是真本事!",
 "gen.dingfeng.bark.tilt": "雪里,见真章!",
 "gen.dingfeng.bark.smug": "东兴之捷,犹在昨日。",
 "gen.dingfeng.bark.badbeat": "老将迟暮,刀不迟。",
 "gen.panzhang.name": "潘璋",
 "gen.panzhang.bio": "截粮擒将,不择手段。",
 "gen.panzhang.tell.strong": "刀横在窄路上,狞笑",
 "gen.panzhang.tell.weak": "盯着别人的好刀好马",
 "gen.panzhang.bark.open": "潘璋,字文珪。",
 "gen.panzhang.bark.taunt": "你的兵器,归我了!",
 "gen.panzhang.bark.tilt": "麦城,收网!",
 "gen.panzhang.bark.smug": "青龙刀,真趁手。",
 "gen.panzhang.bark.badbeat": "这刀……烫手!",
 "gen.zhuran.name": "朱然",
 "gen.zhuran.bio": "坚守江陵,火中不乱。",
 "gen.zhuran.tell.strong": "城中粮册翻得极熟",
 "gen.zhuran.tell.weak": "数着城外又添了几层围",
 "gen.zhuran.bark.open": "朱然,字义封。",
 "gen.zhuran.bark.taunt": "围我六月,又如何?",
 "gen.zhuran.bark.tilt": "守!",
 "gen.zhuran.bark.smug": "火起不了。",
 "gen.zhuran.bark.badbeat": "援军……为何不至?",
 "gen.weiyan.name": "魏延",
 "gen.weiyan.bio": "子午谷一条路,没人肯走。",
 "gen.weiyan.tell.strong": "按剑而立,眼里全是长安",
 "gen.weiyan.tell.weak": "又一次收起自请的战书",
 "gen.weiyan.bark.open": "魏延,字文长。",
 "gen.weiyan.bark.taunt": "给兵一万,直取长安!",
 "gen.weiyan.bark.tilt": "谁敢扼我!",
 "gen.weiyan.bark.smug": "丞相不在,看我出场。",
 "gen.weiyan.bark.badbeat": "谁敢杀我——!",
 "gen.madai.name": "马岱",
 "gen.madai.bio": "堂弟,断后与补刀都稳。",
 "gen.madai.tell.strong": "刀法沉实,不抢不慌",
 "gen.madai.tell.weak": "留意兄长的战马去向",
 "gen.madai.bark.open": "马岱,请战。",
 "gen.madai.bark.taunt": "岱不与兄长争锋。",
 "gen.madai.bark.tilt": "截住退路!",
 "gen.madai.bark.smug": "马家,还有人。",
 "gen.madai.bark.badbeat": "兄长……先走!",
 "gen.guanping.name": "关平",
 "gen.guanping.bio": "义子,刀法与心性同正。",
 "gen.guanping.tell.strong": "横刀护在父亲侧后",
 "gen.guanping.tell.weak": "替父亲拢了拢披风",
 "gen.guanping.bark.open": "关平,候教。",
 "gen.guanping.bark.taunt": "辱我父者,先过我。",
 "gen.guanping.bark.tilt": "随父突围!",
 "gen.guanping.bark.smug": "关家刀,未失分寸。",
 "gen.guanping.bark.badbeat": "父亲……孩儿先行一步。",
 "gen.zhoucang.name": "周仓",
 "gen.zhoucang.bio": "扛刀的,脚程天下第一。",
 "gen.zhoucang.tell.strong": "扛着八十二斤如提竹杖",
 "gen.zhoucang.tell.weak": "望着水军旗帜直咬牙",
 "gen.zhoucang.bark.open": "周仓,给关公扛刀!",
 "gen.zhoucang.bark.taunt": "俺的刀,也不轻!",
 "gen.zhoucang.bark.tilt": "踩水,也追上他!",
 "gen.zhoucang.bark.smug": "赤兔都要歇,俺不用。",
 "gen.zhoucang.bark.badbeat": "将军……先渡!",
 "gen.zhangbao.name": "张苞",
 "gen.zhangbao.bio": "虎父之子,蛇矛新主。",
 "gen.zhangbao.tell.strong": "矛出如虎,大喝开路",
 "gen.zhangbao.tell.weak": "与关兴争功时红了脸",
 "gen.zhangbao.bark.open": "张苞,承父之矛!",
 "gen.zhangbao.bark.taunt": "俺爹的名号,听过吗?",
 "gen.zhangbao.bark.tilt": "杀过去!",
 "gen.zhangbao.bark.smug": "将门虎子。",
 "gen.zhangbao.bark.badbeat": "兴哥……替我。",
 "gen.guanxing.name": "关兴",
 "gen.guanxing.bio": "青龙刀的第二次出鞘。",
 "gen.guanxing.tell.strong": "刀随身走,快而不乱",
 "gen.guanxing.tell.weak": "抚过刀鞘上父亲的旧痕",
 "gen.guanxing.bark.open": "关兴,请战。",
 "gen.guanxing.bark.taunt": "家父之刀,不斩无名。",
 "gen.guanxing.bark.tilt": "此刀,偿父债!",
 "gen.guanxing.bark.smug": "虎父无犬子。",
 "gen.guanxing.bark.badbeat": "苞弟……先撤!",
 "gen.fazheng.name": "法正",
 "gen.fazheng.bio": "睚眦必报,奇谋亦必报。",
 "gen.fazheng.tell.strong": "以目示意,锋藏在袖"
}